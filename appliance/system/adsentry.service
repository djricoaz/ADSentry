[Unit]
Description=ADSentry - pile Docker Compose (API, planificateur, IA locale, HTTPS)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/adsentry/appliance
EnvironmentFile=/opt/adsentry/.env
ExecStart=/usr/bin/docker compose --env-file /opt/adsentry/.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /opt/adsentry/.env down
ExecReload=/usr/bin/docker compose --env-file /opt/adsentry/.env up -d --remove-orphans
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
