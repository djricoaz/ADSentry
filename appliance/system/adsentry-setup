#!/usr/bin/env bash
# Assistant de premier démarrage de l'appliance ADSentry (console ou SSH, en root).
# Configure : nom d'hôte, réseau, DNS (vers les DC), NTP, compte administrateur web, TLS, modèle IA.
# Les cibles d'audit (AD, Entra ID), les scans et les autres comptes se gèrent ensuite dans la console web.
set -euo pipefail

ENV_FILE=/opt/adsentry/.env
CONF=/etc/adsentry
[[ $EUID -eq 0 ]] || { echo "À lancer en root (sudo adsentry-setup)"; exit 1; }

ask() { local prompt=$1 default=${2:-}; local v; read -r -p "$prompt${default:+ [$default]} : " v; echo "${v:-$default}"; }
ask_secret() { local v; read -r -s -p "$1 : " v; echo >&2; echo "$v"; }

echo "=== ADSentry – configuration initiale ==="

# --- Identité et réseau --------------------------------------------------------
HOSTNAME_FQDN=$(ask "Nom DNS de l'appliance" "adsentry.$(hostname -d 2>/dev/null || echo local)")
hostnamectl set-hostname "${HOSTNAME_FQDN%%.*}"
IFACE=$(ip -o -4 route show to default | awk '{print $5}' | head -1)
if [[ $(ask "Adresse IP statique ? (o/n)" "o") == "o" ]]; then
  IP_CIDR=$(ask "Adresse IP/masque (ex. 10.0.1.50/24)")
  GW=$(ask "Passerelle")
  cat > /etc/systemd/network/10-adsentry.network <<EOF
[Match]
Name=$IFACE
[Network]
Address=$IP_CIDR
Gateway=$GW
EOF
fi
DNS_SERVERS=$(ask "Serveurs DNS = contrôleurs de domaine (séparés par des espaces)")
NTP_SERVERS=$(ask "Serveurs NTP (Kerberos exige < 5 min d'écart)" "$DNS_SERVERS")
mkdir -p /etc/systemd/resolved.conf.d /etc/chrony/sources.d
printf '[Resolve]\nDNS=%s\nDomains=~.\n' "$DNS_SERVERS" > /etc/systemd/resolved.conf.d/adsentry.conf
: > /etc/chrony/sources.d/adsentry.sources
for s in $NTP_SERVERS; do echo "server $s iburst" >> /etc/chrony/sources.d/adsentry.sources; done
systemctl restart systemd-networkd systemd-resolved chrony || true

# --- Accès web -----------------------------------------------------------------
ADMIN_USER=$(ask "Identifiant de l'administrateur de la console" "admin")
ADMIN_PWD=$(ask_secret "Mot de passe (12 caractères minimum, 3 types de caractères)")
[[ ${#ADMIN_PWD} -ge 12 ]] || { echo "Mot de passe trop court"; exit 1; }
if [[ $(ask "Certificat TLS fourni par votre PKI ? (o/n)" "n") == "o" ]]; then
  echo "Copiez cert.pem et key.pem dans $CONF/tls/ puis appuyez sur Entrée"; read -r
  TLS="$CONF/tls/cert.pem $CONF/tls/key.pem"
else
  TLS="internal"
fi

# --- IA ------------------------------------------------------------------------
MEM_GB=$(awk '/MemTotal/ {printf "%d", $2/1024/1024}' /proc/meminfo)
MODEL=$(ask "Modèle de base Ollama (CPU)" "qwen3.5:4b")
OLLAMA_MEM=$(( MEM_GB > 12 ? MEM_GB - 4 : 6 ))

cat > "$ENV_FILE" <<EOF
ADSENTRY_HOSTNAME=$HOSTNAME_FQDN
ADSENTRY_TLS=$TLS
ADSENTRY_BASE_MODEL=$MODEL
OLLAMA_MEMORY=${OLLAMA_MEM}g
OLLAMA_CPUS=$(( $(nproc) > 2 ? $(nproc) - 1 : 1 ))
TZ=$(timedatectl show -p Timezone --value)
EOF
chmod 600 "$ENV_FILE"

# Clé maître des secrets (Fernet) : créée sur l'hôte, lisible par le seul groupe du service (uid 10001)
if [[ ! -f $CONF/master.key ]]; then
  head -c 32 /dev/urandom | base64 | tr '+/' '-_' > "$CONF/master.key"
  chown root:10001 "$CONF/master.key" && chmod 440 "$CONF/master.key"
fi

# --- Compte administrateur de la console ----------------------------------------
COMPOSE=(docker compose -f /opt/adsentry/appliance/docker-compose.yml --env-file "$ENV_FILE")
if "${COMPOSE[@]}" run --rm --no-deps api adsentry user list | awk '{print $1}' | grep -qx "$ADMIN_USER"; then
  "${COMPOSE[@]}" run --rm --no-deps -e ADSENTRY_USER_PASSWORD="$ADMIN_PWD" api adsentry user passwd "$ADMIN_USER"
else
  "${COMPOSE[@]}" run --rm --no-deps -e ADSENTRY_USER_PASSWORD="$ADMIN_PWD" api \
    adsentry user add "$ADMIN_USER" --role admin --name "Administrateur"
fi
unset ADMIN_PWD

systemctl enable --now adsentry.service
echo "Téléchargement des modèles IA (plusieurs minutes)…"
docker compose -f /opt/adsentry/appliance/docker-compose.yml --env-file "$ENV_FILE" --profile init run --rm ollama-init
echo
echo "Terminé. Console : https://$HOSTNAME_FQDN  (identifiant : $ADMIN_USER)"
echo "Ensuite, dans la console : Administration > Cibles d'audit > Ajouter une cible, puis « Lancer le scan »."
echo "Comptes en lecture seule : Administration > Comptes et rôles (rôle « Lecteur »)."
