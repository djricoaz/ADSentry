{
	admin off
	servers {
		protocols h1 h2
	}
}

http://{$ADSENTRY_HOSTNAME} {
	redir https://{host}{uri} permanent
}

{$ADSENTRY_HOSTNAME} {
	# ADSENTRY_TLS = « internal » (AC interne Caddy, par défaut) ou « /etc/adsentry/tls/cert.pem /etc/adsentry/tls/key.pem »
	tls {$ADSENTRY_TLS}

	# Authentification : comptes et rôles gérés par l'application (session HttpOnly), cf. docs/APPLIANCE.md

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		# Cadres autorisés pour la console elle-même uniquement (topologie, guide) ; aucun site tiers
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; frame-ancestors 'self'; frame-src 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
		format json
	}
}
